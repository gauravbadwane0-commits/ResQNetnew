# ==========================================
# RESQNET Emergency Network Environment Variables
# ==========================================

# 1. Google Maps Platform API Key
# Required for Google Maps rendering, geocoding, places, and directions.
# Get your API key at: https://console.cloud.google.com/google/maps-apis/
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# 2. Optional: Mapbox Public Token (if using Mapbox tiles)
# Get your token at: https://account.mapbox.com/
VITE_MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN_HERE

# 3. Default Map Provider: 'google' | 'mapbox' | 'carto_osm'
# - 'google': Google Maps Platform (Requires VITE_GOOGLE_MAPS_API_KEY)
# - 'mapbox': Mapbox (Requires VITE_MAPBOX_ACCESS_TOKEN)
# - 'carto_osm': OpenStreetMap / CartoDB (100% Free, zero key required)
VITE_MAP_PROVIDER=google
